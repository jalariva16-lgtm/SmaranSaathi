# Groq Configuration (LLM)
# Recommended models: openai/gpt-oss-120b, qwen/qwen3-32b, llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Persistent Memory Configuration
# Standard Hindsight server runs on port 8888 (e.g. docker run -p 8888:8888 ghcr.io/vectorize-io/hindsight:latest)
# or via Hindsight Cloud (https://api.hindsight.vectorize.io)
# or via the built-in standalone Hindsight server: npm run hindsight:server
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_MS=4000

# Backend Server Port
PORT=3001
